# 复制为 backup.env 后按需修改；backup.env 已在 .gitignore 中，不会进入仓库。
# 远程地址通过 git remote 配置，不在此文件。

# 分支与远程名
SML_BRANCH=main
SML_REMOTE=origin

# 无口令部署密钥路径；留空则使用 ssh-agent 中已载入的密钥。
# Linux 示例：SML_SSH_KEY=/root/.ssh/sml_backup_ed25519
# Windows 示例：SML_SSH_KEY=C:/Users/Lucas/.ssh/id_rsa
SML_SSH_KEY=

# 可选：自定义仓库目录与日志位置
# SML_REPO_DIR=/opt/sml-server
# SML_BACKUP_LOG=/opt/sml-server/backup.log
